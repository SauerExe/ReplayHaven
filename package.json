{
  "name": "replayhaven",
  "version": "1.0.0",
  "description": "Self-hosted game clip archive: Windows client with local AI analysis, Docker server, cinematic web library.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/SauerExe/ReplayHaven.git"
  },
  "homepage": "https://github.com/SauerExe/ReplayHaven#readme",
  "bugs": {
    "url": "https://github.com/SauerExe/ReplayHaven/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test:e2e": "playwright test",
    "check:browser": "node scripts/browser-check.mjs",
    "media:refresh": "node scripts/fetch-media.mjs",
    "server": "tsx server/index.ts",
    "dev:all": "concurrently -k \"npm run server\" \"npm run dev\"",
    "agent": "tsx agent/index.ts",
    "fortnite": "tsx agent/fortnite-cli.ts",
    "audio": "tsx agent/audio-cli.ts",
    "laughs": "tsx agent/laughs-cli.ts",
    "r6": "tsx agent/r6-cli.ts",
    "r6-replays": "tsx agent/r6-replays-cli.ts",
    "client:prepare": "node scripts/build-client.mjs",
    "client:dev": "npm run client:prepare && electron desktop-bundle",
    "client:build": "npm run client:prepare && electron-builder --config electron-builder.yml --win nsis --x64",
    "server:bundle": "node scripts/build-server.mjs",
    "release:server": "node scripts/package-server.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:build": "docker build -t replayhaven:local ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.4",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@google/genai": "^2.24.0",
    "fastify": "^5.12.5",
    "ffmpeg-static": "^5.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@gutenye/ocr-models": "^1.4.2",
    "@playwright/test": "^1.55.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "hls.js": "^1.6.13",
    "lucide-react": "^0.468.0",
    "onnxruntime-node": "^1.30.0",
    "prettier": "^3.9.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
