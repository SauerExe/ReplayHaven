# ReplayHaven server configuration.
# Docker Compose reads this file automatically; every variable also reaches the container.

# Required. Shared access key for browser and Windows client, at least 24 characters.
# Generate one with: openssl rand -hex 24
REPLAYHAVEN_ACCESS_TOKEN=

# The address people open in the browser: scheme, host and port, no trailing slash.
# It must match exactly, otherwise API requests are rejected as foreign origins.
REPLAYHAVEN_PUBLIC_ORIGIN=http://localhost:8787

# Host port published by Docker (the container always listens on 8787).
REPLAYHAVEN_HOST_PORT=8787

# Image to run. Leave unset for the published image; setup-server.sh writes
# replayhaven:local here when it builds from source.
#REPLAYHAVEN_IMAGE=ghcr.io/sauerexe/replayhaven:latest

# Where the "Download Windows client" button points when no installer is mounted in ./release.
# Release images already carry the matching GitHub release URL; set this to override it.
#REPLAYHAVEN_CLIENT_DOWNLOAD_URL=https://github.com/SauerExe/ReplayHaven/releases/latest/download/ReplayHaven-Client-Setup.exe

# Automatically fetch game descriptions, genres, release dates and covers from Steam.
# Enabled by default; no API key needed. Set to 0 to disable outgoing game lookups.
#REPLAYHAVEN_GAME_METADATA=1

# Optional second source for games that are not on Steam (Valorant, Fortnite, Minecraft …):
# IGDB by Twitch, free for non-commercial use. Create an application at
# https://dev.twitch.tv/console/apps (OAuth redirect http://localhost, category "Application
# Integration") and copy its Client ID and a new Client Secret here. Only game names are sent.
#REPLAYHAVEN_IGDB_CLIENT_ID=
#REPLAYHAVEN_IGDB_CLIENT_SECRET=

# Optional server-side AI. Not needed when the Windows client analyzes clips locally.
# See docs/SERVER.md. Values: none (default), local, gemini
#REPLAYHAVEN_AI_PROVIDER=none
#REPLAYHAVEN_AI_MODEL=
#REPLAYHAVEN_LOCAL_AI_URL=http://modelhost:8000/v1
#REPLAYHAVEN_LOCAL_AI_KEY=
#GEMINI_API_KEY=
